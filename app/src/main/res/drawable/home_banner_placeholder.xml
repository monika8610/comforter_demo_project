<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="0"
                android:endColor="#2B0B0A"
                android:startColor="#B86A18" />
        </shape>
    </item>
    <item
        android:right="18dp"
        android:top="18dp">
        <shape android:shape="oval">
            <size
                android:width="92dp"
                android:height="92dp" />
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="26dp"
        android:left="18dp"
        android:right="130dp"
        android:top="28dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="90"
                android:endColor="#00000000"
                android:startColor="#55000000" />
        </shape>
    </item>
</layer-list>
